<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
    <head>
        <link name="NotoSansArabic" type="font" subtype="opentype"
            src="${nsfont.NotoSansArabic_Regular}" src-bold="${nsfont.NotoSansArabic_Bold}"
            bytes="2" subset="false" />
        <link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}"
            src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}"
            src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />

        <title>Audit Report</title>
        <meta name="title" value="Audit Report" />

        <macrolist>
            <macro id="nlheader">
                <table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin-bottom: 30px;">
                    <tr>
                        <td style="width: 250px; vertical-align: middle; padding-right: 30px;">
                            <img src="${auditReportData.subsidiary.logoUrl?xml}" style="height: 100%; width: 100%; display:block;" />
                        </td>
                        <td style="vertical-align: middle; text-align: center; align: center; font-size: 28px; font-weight: bold;">
                            AUDIT REPORT
                        </td>
                        <td style="width: 250px;"></td>
                    </tr>
                </table>
            </macro>

            <macro id="nlfooter">
                <table class="footer" style="width: 100%;">
                    <tr>
                        <td align="right"><pagenumber /> of <totalpages /></td>
                    </tr>
                </table>
            </macro>
        </macrolist>

        <style type="text/css">
            * {
                <#if .locale == "zh_CN">
                    font-family: NotoSans, NotoSansCJKsc, sans-serif;
                <#elseif .locale == "zh_TW">
                    font-family: NotoSans, NotoSansCJKtc, sans-serif;
                <#elseif .locale == "ja_JP">
                    font-family: NotoSans, NotoSansCJKjp, sans-serif;
                <#elseif .locale == "ko_KR">
                    font-family: NotoSans, NotoSansCJKkr, sans-serif;
                <#elseif .locale == "th_TH">
                    font-family: NotoSans, NotoSansThai, sans-serif;
                <#else>
                    font-family: NotoSansArabic, NotoSans, sans-serif;
                </#if>
            }
            span.title  { font-size: 28pt; }
            span.number { font-size: 16pt; }
            table.main td, th { border-bottom: 1px solid #ddd; }
            td.empty { border: none; }
            th {
                font-weight: bold;
                vertical-align: middle;
                padding: 5px 6px 3px;
                background-color: #e3e3e3;
                color: #333333;
            }
            td { padding: 4px 6px; }
            td p { align: left; }
        </style>
    </head>

    <body header="nlheader" header-height="15%" footer="nlfooter" footer-height="3%"
        padding="0.5in 0.5in 0.5in 0.5in" size="14in 18in">

        <!-- ===== Company Info Block ===== -->
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <!-- Left: Company / Subsidiary info -->
                <td style="width: 50%; padding: 10px; vertical-align: top;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Company Name:</td>
                            <td style="padding: 8px 0;">${auditReportData.subsidiary.name}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Subsidiary:</td>
                            <td style="padding: 8px 0;">${auditReportData.subsidiary.name}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Company TRN:</td>
                            <td style="padding: 8px 0;">${auditReportData.subsidiary.vatregnumber}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Address:</td>
                            <td style="padding: 8px 0;">${auditReportData.subsidiary.mainaddress_text}</td>
                        </tr>
                    </table>
                </td>

                <!-- Right: Report period metadata -->
                <td style="width: 50%; padding: 10px; vertical-align: top;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Current Year (${auditReportData.currentYear?c}):</td>
                            <td style="padding: 8px 0;">${auditReportData.currentYearFrom} - ${auditReportData.currentYearTo}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Previous Year (${auditReportData.previousYear?c}):</td>
                            <td style="padding: 8px 0;">${auditReportData.previousYearFrom} - ${auditReportData.previousYearTo}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Account Types:</td>
                            <td style="padding: 8px 0;">${auditReportData.accountTypes}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Generated On:</td>
                            <td style="padding: 8px 0;">${auditReportData.printDate}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- ===== Transactions Table ===== -->
        <h2 style="font-size: 18px; font-weight: bold; margin: 10px 0 10px 0; letter-spacing: 1px;">Transactions by Account Type</h2>

        <table style="width: 100%; border-collapse: collapse; margin-top: 15px; border: 1px solid black; font-size: 10pt;">
            <thead>
                <tr>
                    <th style="padding: 6px 4px; text-align: left;  border: 1px solid black;">#</th>
                    <th style="padding: 6px 4px; text-align: left;  border: 1px solid black;">Account Type</th>
                    <th style="padding: 6px 4px; text-align: left;  border: 1px solid black;">Account</th>
                    <th style="padding: 6px 4px; text-align: right; border: 1px solid black;">${auditReportData.currentYear?c}</th>
                    <th style="padding: 6px 4px; text-align: right; border: 1px solid black;">${auditReportData.previousYear?c}</th>
                </tr>
            </thead>
            <tbody>

                <#assign rowNum = 1>
                <#list auditReportData.groups as group>

                    <!-- Account Type bold header row -->
                    <tr style="background-color: #c8d8e8;">
                        <td colspan="3" style="padding: 6px 8px; text-align: left; border: 1px solid black; font-weight: bold;">
                            ${group.accountTypeLabel?xml}
                        </td>
                        <td style="padding: 6px 4px; text-align: right; border: 1px solid black; font-weight: bold;">
                            ${group.subtotalCurrentYear?number?string["#,##0.00"]}
                        </td>
                        <td style="padding: 6px 4px; text-align: right; border: 1px solid black; font-weight: bold;">
                            ${group.subtotalPreviousYear?number?string["#,##0.00"]}
                        </td>
                    </tr>

                    <!-- Individual account rows -->
                    <#list group.accounts as acc>
                        <tr>
                            <td style="padding: 5px 4px; text-align: center; border: 1px solid black;">
                                ${rowNum}
                                <#assign rowNum = rowNum + 1>
                            </td>
                            <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                                ${acc.accountType?xml}
                            </td>
                            <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                                ${acc.account?xml}
                            </td>
                            <td style="padding: 5px 4px; text-align: right; border: 1px solid black;">
                                ${acc.amountCurrentYear?number?string["#,##0.00"]}
                            </td>
                            <td style="padding: 5px 4px; text-align: right; border: 1px solid black;">
                                ${acc.amountPreviousYear?number?string["#,##0.00"]}
                            </td>
                        </tr>
                    </#list>

                </#list>

            </tbody>
            <tfoot>
                <tr style="background-color: #e3e3e3; font-weight: bold;">
                    <td colspan="3" style="padding: 8px 4px; text-align: right; border: 1px solid black; font-weight: bold;">Grand Total</td>
                    <td style="padding: 8px 4px; text-align: right; border: 1px solid black;">
                        ${auditReportData.grandTotalCurrentYear?number?string["#,##0.00"]}
                    </td>
                    <td style="padding: 8px 4px; text-align: right; border: 1px solid black;">
                        ${auditReportData.grandTotalPreviousYear?number?string["#,##0.00"]}
                    </td>
                </tr>
            </tfoot>
        </table>

    </body>
</pdf>