<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
    <head>
        <link name="NotoSansArabic" type="font" subtype="opentype"
            src="${nsfont.NotoSansArabic_Regular}" src-bold="${nsfont.NotoSansArabic_Bold}"
            bytes="2" subset="false" />
        <link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}"
            src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}"
            src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />

        <title>${vendorStatementData.vendorInfo.companyname?xml}</title>
<meta name="title" value="${vendorStatementData.vendorInfo.entityid?xml} ${vendorStatementData.vendorInfo.companyname?xml}" />

        <macrolist>
            <macro id="nlheader">


       <table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin-bottom: 30px;">
            <tr>
                <td style="width: 250px; vertical-align: middle; padding-right: 30px;">
                    <img src="https://8446237-sb1.app.netsuite.com/core/media/media.nl?id=799&amp;c=8446237_SB1&amp;h=oRqhhK9vP5kA3eHhALX1KqNGDB3yjL_lOiF8tiuO-n2n3K2o"style="height: 4%; width: 4%; display:block;" />

                </td>
                <td style="vertical-align: middle; text-align: center;align: center;font-size: 28px; font-weight: bold;">
             
                        SUPPLIER STATEMENT OF ACCOUNT
                
                </td>
                <td style="width: 250px;"></td>
            </tr>
        </table>

            </macro>
            <macro id="nlfooter">
                <table class="footer" style="width: 100%;">
                    <tr>

                        <td align="right"><pagenumber /> of <totalpages /></td>
                    </tr>
                </table>
            </macro>
        </macrolist>
		<style type="text/css">* { <#if .locale == "zh_CN"> font-family: NotoSans, NotoSansCJKsc, sans-serif; <#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif; <#elseif .locale == "ja_JP"> font-family: NotoSans,
			NotoSansCJKjp, sans-serif; <#elseif .locale == "ko_KR"> font-family: NotoSans, NotoSansCJKkr, sans-serif; <#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif; <#else>
				font-family: NotoSansArabic, NotoSans, sans-serif;
			</#if> } span.title { font-size:
			28pt; } span.number { font-size: 16pt; } table.main td, th { border-bottom: 1px solid
			#ddd; } td.empty { border: none; } th { font-weight: bold; vertical-align: middle;
			padding: 5px 6px 3px; background-color: #e3e3e3; color: #333333; } td { padding: 4px
			6px; } td p { align:left } 		</style>
    </head>
	<body header="nlheader" header-height="15%" footer="nlfooter" footer-height="3%"
		padding="0.5in 0.5in 0.5in 0.5in" size="14in 18in">

        
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <td style="width: 50%; padding: 10px; vertical-align: top;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Company Name:</td>
                            <td style="padding: 8px 0;">${vendorStatementData.subsidiary.name}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Subsidiary:</td>
                            <td style="padding: 8px 0;">${vendorStatementData.subsidiary.name}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Company TRN:</td>
                            <td style="padding: 8px 0;">${vendorStatementData.subsidiary.vatregnumber}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Address:</td>
                            <td style="padding: 8px 0;">${vendorStatementData.subsidiary.mainaddress_text}</td>
                        </tr>
                    </table>
                </td>
                <td style="width: 50%; padding: 10px; vertical-align: top;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Supplier Name:</td>
                            <td style="padding: 8px 0;">${vendorStatementData.vendorInfo.companyname}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Supplier Code:</td>
                            <td style="padding: 8px 0;"></td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Supplier TRN:</td>
                            <td style="padding: 8px 0;">${vendorStatementData.vendorInfo.vatregnumber}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Statement Period:</td>
                            <td style="padding: 8px 0;">from ${vendorStatementData.fromDate} to ${vendorStatementData.toDate}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Currency:</td>
                            <td style="padding: 8px 0;">${vendorStatementData.vendorInfo.currency}</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; padding: 8px 10px 8px 0; vertical-align: top;">Generated On:</td>
                            <td style="padding: 8px 0;">${vendorStatementData.printDate}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

    <!-- opening balance Table -->
         <h2 style="font-size: 18px; font-weight: bold; margin: 10px 0 10px 0; letter-spacing: 1px;">Opening Balance</h2>
         <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
            <tr style="background-color: #c0c0c0;">
                <td style="padding: 12px; font-weight: bold; border: 1px solid #000;">Opening Balance  at ${vendorStatementData.fromDate}</td>
                <td style="padding: 12px; border: 1px solid #000;"></td>
            </tr>
            <tr>
                <td style="padding: 12px; border: 1px solid #000;">Debit Balance</td>
                <td style="padding: 12px; text-align: right; border: 1px solid #000;">
                    <#if vendorStatementData.openingBalance.balance?number gt 0>
                         ${vendorStatementData.openingBalance.balance?number?string["#,##0.00"]}
                         <#else>
                         0.00
                    </#if>
                
                </td> 
            </tr>
            <tr>
                <td style="padding: 12px; border: 1px solid #000;">Credit Balance</td>
                <td style="padding: 12px; text-align: right; border: 1px solid #000;">
                             <#if vendorStatementData.openingBalance.balance?number lt 0>
                         ${vendorStatementData.openingBalance.balance?number?string["#,##0.00"]}
                             <#else>
                         0.00
                    </#if>
                </td>
            </tr>
        </table>
        
    <!-- Transactions Table -->
       <h2 style="font-size: 18px; font-weight: bold; margin: 10px 0 10px 0; letter-spacing: 1px;">Transactions</h2>
<table style="width: 100%; border-collapse: collapse; margin-top: 15px; border: 1px solid black; font-size: 10pt;">
    <thead>
        <tr>
            <th style="padding: 6px 4px; text-align: left; border: 1px solid black;">#</th>
             <th style="padding: 6px 4px; text-align: left; border: 1px solid black;">Date</th>
            <th style="padding: 6px 4px; text-align: left; border: 1px solid black;">Document Type</th>
            <th style="padding: 6px 4px; text-align: left; border: 1px solid black;">Document No</th>
            <th style="padding: 6px 4px; text-align: left; border: 1px solid black;">Supplier Ref</th>
            <th style="padding: 6px 4px; text-align: left; border: 1px solid black;">Description</th>
                 <th style="padding: 6px 4px; text-align: left; border: 1px solid black;">Location</th>
            <th style="padding: 6px 4px; text-align: left; border: 1px solid black;">Due Date</th>

            <th style="padding: 6px 4px; text-align: right; border: 1px solid black;">Debit</th>
            <th style="padding: 6px 4px; text-align: right; border: 1px solid black;">Credit</th>
            <th style="padding: 6px 4px; text-align: right; border: 1px solid black;">Balance</th>

        </tr>
    </thead>
    <tbody>
        <#list vendorStatementData.transactions as transaction>
            <tr>
                <td style="padding: 5px 4px; text-align: center; border: 1px solid black;">
                    ${transaction_index + 1}
                </td>
                     <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                    ${transaction.date?xml}
                </td>
                <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                    ${transaction.type?xml}
                </td>
           
                <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                    ${transaction.tranid?xml}
                </td>
                     <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                    ${transaction.transactionNumber?xml}
                </td>
                <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                    ${transaction.memo?xml}
                </td>
                     <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                    ${transaction.location?xml}
                </td>
                       <td style="padding: 5px 4px; text-align: left; border: 1px solid black;">
                    ${transaction.dueDate?xml}
                </td>
                <td style="padding: 5px 4px; text-align: right; border: 1px solid black;">

                    ${transaction.debit?number?string["#,##0.00"]}
                </td>
                <td style="padding: 5px 4px; text-align: right; border: 1px solid black;">
                    ${transaction.credit?number?string["#,##0.00"]}
                </td>
                <td style="padding: 5px 4px; text-align: right; border: 1px solid black;">
                    ${transaction.balance?number?string["#,##0.00"]}
                </td>

            </tr>
        </#list>
    </tbody>
</table>

  <h2 style="font-size: 18px; font-weight: bold; margin: 10px 0 10px 0; letter-spacing: 1px;">SUMMARY</h2>
        
        <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
            <tr>
                <td style="padding: 12px; border: 1px solid #000;">Total Supplier Invoices</td>
                <td style="padding: 12px; text-align: right; border: 1px solid #000;">${vendorStatementData.totalSummary.totalBills?number?string["#,##0.00"]}</td>
            </tr>
            <tr>
                <td style="padding: 12px; border: 1px solid #000;">Total Credit Notes</td>
                <td style="padding: 12px; text-align: right; border: 1px solid #000;">${vendorStatementData.totalSummary.totalBillCredits?number?string["#,##0.00"]}</td>
            </tr>
            <tr>
                <td style="padding: 12px; border: 1px solid #000;">Total Payments Made</td>
                <td style="padding: 12px; text-align: right; border: 1px solid #000;">${vendorStatementData.totalSummary.totalPayments?number?string["#,##0.00"]}</td>
            </tr>
      
            <tr style="background-color: #c0c0c0;">
                <td style="padding: 12px; font-weight: bold; border: 1px solid #000;">Closing Balance as at ${vendorStatementData.toDate}</td>
                <td style="padding: 12px; text-align: right; font-weight: bold; border: 1px solid #000;">${vendorStatementData.totalSummary.closingBalance?number?string["#,##0.00"]}</td>
            </tr>
        </table>

         <div style="margin-top: 60px;">
            <h2 style="font-size: 18px; font-weight: bold; margin: 0 0 10px 0; letter-spacing: 1px;">DECLARATION</h2>
            <p style="margin: 0 0 10px 0; font-size: 14px; line-height: 12;">
                This statement is generated from the accounting records of "${vendorStatementData.subsidiary.name}" and reflects all transactions 
                recorded during the stated period. Any discrepancy should be reported within 7 working days.
            </p>
            <div style="border-top: 1px solid #999; margin: 20px 0;"></div>

        </div>

    </body>

</pdf>