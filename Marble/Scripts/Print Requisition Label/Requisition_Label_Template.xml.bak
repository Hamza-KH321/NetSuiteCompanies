<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
  <head>
    <link name="NotoSans" type="font" subtype="truetype"
      src="${nsfont.NotoSans_Regular}"
      src-bold="${nsfont.NotoSans_Bold}"
      src-italic="${nsfont.NotoSans_Italic}"
      src-bolditalic="${nsfont.NotoSans_BoldItalic}"
      bytes="2" />

    <link name="NotoSansArabic" type="font" subtype="opentype"
      src="${nsfont.NotoSansArabic_Regular}"
      src-bold="${nsfont.NotoSansArabic_Bold}"
      bytes="2" subset="false" />

    <#if .locale == "zh_CN">
    <link name="NotoSansCJKsc" type="font" subtype="opentype"
      src="${nsfont.NotoSansCJKsc_Regular}"
      src-bold="${nsfont.NotoSansCJKsc_Bold}"
      bytes="2" />
    <#elseif .locale == "zh_TW">
    <link name="NotoSansCJKtc" type="font" subtype="opentype"
      src="${nsfont.NotoSansCJKtc_Regular}"
      src-bold="${nsfont.NotoSansCJKtc_Bold}"
      bytes="2" />
    <#elseif .locale == "ja_JP">
    <link name="NotoSansCJKjp" type="font" subtype="opentype"
      src="${nsfont.NotoSansCJKjp_Regular}"
      src-bold="${nsfont.NotoSansCJKjp_Bold}"
      bytes="2" />
    <#elseif .locale == "ko_KR">
    <link name="NotoSansCJKkr" type="font" subtype="opentype"
      src="${nsfont.NotoSansCJKkr_Regular}"
      src-bold="${nsfont.NotoSansCJKkr_Bold}"
      bytes="2" />
    <#elseif .locale == "th_TH">
      <link name="NotoSansThai" type="font" subtype="opentype"
        src="${nsfont.NotoSansThai_Regular}"
        src-bold="${nsfont.NotoSansThai_Bold}"
        bytes="2" />
    </#if>

    <macrolist>
      <macro id="nlheader">
      </macro>
      <macro id="nlfooter">
      </macro>
    </macrolist>

    <style>
      * {
        font-family: NotoSansArabic, NotoSans, sans-serif;
      }
      table {
        font-size: 6pt;
        table-layout: fixed;
      }
      td {
        padding: 2px 3px;
        vertical-align: top;
        line-height: 1.2;
      }
      b {
        font-weight: bold;
        color: #333333;
      }
    </style>
  </head>

  <body header="nlheader" header-height="0%" footer="nlfooter" footer-height="0%"
    padding="0.2cm 0.2cm 0.2cm 0.2cm" size="10cm 15cm">

    <!-- Loop through each item to create separate pages -->
    <#list record.item as item>
      <#if item?index gt 0>
        <pbr/>
      </#if>

      <!-- Main Container Table with Border -->
      <table style="width: 100%; border: 2px solid #000; border-collapse: collapse; margin: 0; height: 14.6cm;">
        
        <!-- Header Row with Logo, Title and Barcode -->
        <tr style="height: 3cm;">
          <td colspan="6" style="border-bottom: 2px solid #000; padding: 3px; height: 3cm;">
            <table style="width: 100%; border: none; margin: 0; height: 100%;">
              <tr>
                <td style="width: 20%; text-align: center; vertical-align: middle; padding: 2px; border: none;">
                  <img src="https://9698421.app.netsuite.com/core/media/media.nl?id=9632&amp;c=9698421&amp;h=z2YfeEAWW_8EInRlwuQCGgINdGrKPm-17YXSZ2E9puX4smWH" 
                       style="height: 75px; width: 75px;" />
                </td>
                <td style="width: 60%; text-align: center; vertical-align: middle; padding: 2px; border: none;">
                  <table style="width: 100%; border: none; margin: 0;">
                    <tr>
                      <td style="font-size: 9pt; font-weight: bold; padding: 0 0 2px 0; line-height: 1; text-align: center; border: none;">Samples</td>
                    </tr>
                    <!-- Barcode -->
                    <#if record.id?has_content>
                    <tr>
                      <td style="padding: 0; text-align: center; border: none;">
                        <barcode codetype="code128" showtext="false" height="40" width="170" 
                                 value="https://9698421.app.netsuite.com/app/accounting/transactions/purchreq.nl?id=${record.id}&amp;whence=" />
                      </td>
                    </tr>
                    <tr>
                      <td style="font-size: 10pt; padding: 7px 0 0 0; line-height: 1; text-align: center; border: none;">${record.tranid}</td>
                    </tr>
                    </#if>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

		<!-- Production and Expiry Date Section -->
		<tr style="height: 1.5cm;">
		<td colspan="6" style="border-bottom: 2px solid #000; padding: 5px; font-size: 12px; height: 1.5cm; vertical-align: top;">
			<table style="width: 100%; border: none; border-collapse: collapse; margin: 0; padding: 0;">
			<tr>
				<td style="border: none; font-size: 12px; padding: 10px 0 3px 0;"><b>Purpose</b></td>
			</tr>
			<tr>
				<td style="border: none; font-size: 12px; padding: 5px 0 6px 0;">
				<#assign purpose = record.custbody_vs_purpose?has_content?then(record.custbody_vs_purpose, "")>
				
				<!-- R&D Checkbox -->
				<span style="display: inline-block; width: 12px; height: 12px; border: 1.5px solid #000; text-align: center; vertical-align: middle; margin-right: 3px;">
					<#if purpose == "1">&#x2713;</#if>
				</span>
				<span style="margin-right: 20px;">R&amp;D</span>
				
				<!-- Supplier Test Checkbox -->
				<span style="display: inline-block; width: 12px; height: 12px; border: 1.5px solid #000; text-align: center; vertical-align: middle; margin-right: 3px;">
					<#if purpose == "2">&#x2713;</#if>
				</span>
				<span style="margin-right: 20px;">Supplier Test</span>
				
				<!-- Recipe Test Checkbox -->
				<span style="display: inline-block; width: 12px; height: 12px; border: 1.5px solid #000; text-align: center; vertical-align: middle; margin-right: 3px;">
					<#if purpose == "3">&#x2713;</#if>
				</span>
				<span>Recipe Test</span>
				</td>
			</tr>
		
			</table>
		</td>
		</tr>

        <!-- Main Content Section -->
        <tr style="height: 7.5cm;">
          <td colspan="6" style="border-bottom: 2px solid #000; padding: 5px; height: 7.5cm; vertical-align: top; font-size: 12px;">
            <table style="width: 100%; border: none; border-collapse: collapse; margin: 0; padding: 0;">
              <tr>
                <td style="border: none; font-size: 12px; padding: 7px 0 12px 0;"><b>Sample Name: </b>${record.entity}</td>
              </tr>
              <tr>
                <td style="border: none; font-size: 12px; padding: 7px 0 12px 0;"><b>Date: </b>${record.trandate}</td>
              </tr>
              <tr>
                <td style="border: none; font-size: 12px; padding: 7px 0 12px 0;"><b>Prepared By: </b>${record.entity}</td>
              </tr>
              <tr>
                <td style="border: none; font-size: 12px; padding: 0;">
                  <table style="width: 100%; border: none; margin: 0; padding: 0;">
                    <tr>
                      <td style="border: none; font-size: 12px; padding: 5px 0 4px 0;"><b>Status: </b> ${record.approvalstatus}</td>
                    </tr>
                    <tr>
                      <td style="border: none; font-size: 12px; padding: 10px 0 4px 0;"><b>Notes: </b> ${record.memo}</td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>

    </#list>

  </body>
</pdf>